<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_KT2" targetNamespace="https://example.org/kt2/virtual-tour" exporter="Example educational model">
  <bpmn:process id="Process_Tour" name="Сборка и публикация виртуального тура" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Tour">
      <bpmn:lane id="Lane_Operator" name="Оператор">
        <bpmn:flowNodeRef>Start_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return_Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm_Mapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Set_Transitions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fix_Tour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review_Preview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transfer_URL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Published</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Create_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Load_Scenes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Suggest_Mapping</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate_Tour</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Build_Preview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publish</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Input" name="Комплект получен">
      <bpmn:messageEventDefinition id="MessageStartDefinition" messageRef="Message_Input" />
    </bpmn:startEvent>
    <bpmn:userTask id="Check_Input" name="Проверить комплект входных данных" />
    <bpmn:exclusiveGateway id="Gateway_Input" name="Комплект полный?" />
    <bpmn:userTask id="Return_Input" name="Вернуть комплект на доработку" />
    <bpmn:endEvent id="End_Returned" name="Комплект возвращён" />
    <bpmn:serviceTask id="Create_Draft" name="Создать черновик тура" />
    <bpmn:serviceTask id="Load_Scenes" name="Загрузить панорамы и создать сцены" />
    <bpmn:serviceTask id="Suggest_Mapping" name="Предложить сопоставление панорам помещениям" />
    <bpmn:userTask id="Confirm_Mapping" name="Подтвердить сопоставление панорам помещениям" />
    <bpmn:userTask id="Choose_Start" name="Выбрать стартовую сцену" />
    <bpmn:userTask id="Set_Transitions" name="Задать переходы между сценами" />
    <bpmn:serviceTask id="Validate_Tour" name="Проверить структуру и достижимость тура" />
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Проверка успешна?" />
    <bpmn:userTask id="Fix_Tour" name="Исправить сцены и переходы" />
    <bpmn:serviceTask id="Build_Preview" name="Сформировать предпросмотр тура" />
    <bpmn:userTask id="Review_Preview" name="Проверить тур в предпросмотре" />
    <bpmn:exclusiveGateway id="Gateway_Review" name="Есть замечания?" />
    <bpmn:serviceTask id="Publish" name="Опубликовать проверенную версию и сформировать URL" />
    <bpmn:userTask id="Transfer_URL" name="Передать URL риелтору" />
    <bpmn:endEvent id="End_Published" name="Тур передан" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Input" targetRef="Check_Input" />
    <bpmn:sequenceFlow id="F02" sourceRef="Check_Input" targetRef="Gateway_Input" />
    <bpmn:sequenceFlow id="F03" sourceRef="Gateway_Input" targetRef="Create_Draft" name="Да" />
    <bpmn:sequenceFlow id="F04" sourceRef="Gateway_Input" targetRef="Return_Input" name="Нет" />
    <bpmn:sequenceFlow id="F05" sourceRef="Return_Input" targetRef="End_Returned" />
    <bpmn:sequenceFlow id="F06" sourceRef="Create_Draft" targetRef="Load_Scenes" />
    <bpmn:sequenceFlow id="F07" sourceRef="Load_Scenes" targetRef="Suggest_Mapping" />
    <bpmn:sequenceFlow id="F08" sourceRef="Suggest_Mapping" targetRef="Confirm_Mapping" />
    <bpmn:sequenceFlow id="F09" sourceRef="Confirm_Mapping" targetRef="Choose_Start" />
    <bpmn:sequenceFlow id="F10" sourceRef="Choose_Start" targetRef="Set_Transitions" />
    <bpmn:sequenceFlow id="F11" sourceRef="Set_Transitions" targetRef="Validate_Tour" />
    <bpmn:sequenceFlow id="F12" sourceRef="Validate_Tour" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="F13" sourceRef="Gateway_Valid" targetRef="Build_Preview" name="Да" />
    <bpmn:sequenceFlow id="F14" sourceRef="Gateway_Valid" targetRef="Fix_Tour" name="Нет" />
    <bpmn:sequenceFlow id="F15" sourceRef="Fix_Tour" targetRef="Validate_Tour" />
    <bpmn:sequenceFlow id="F16" sourceRef="Build_Preview" targetRef="Review_Preview" />
    <bpmn:sequenceFlow id="F17" sourceRef="Review_Preview" targetRef="Gateway_Review" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gateway_Review" targetRef="Publish" name="Нет" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gateway_Review" targetRef="Fix_Tour" name="Да" />
    <bpmn:sequenceFlow id="F20" sourceRef="Publish" targetRef="Transfer_URL" />
    <bpmn:sequenceFlow id="F21" sourceRef="Transfer_URL" targetRef="End_Published" />
    <bpmn:dataObject id="Input_Package" name="Входной комплект" />
    <bpmn:dataObjectReference id="Input_Package_ref" name="Входной комплект" dataObjectRef="Input_Package" />
    <bpmn:dataObject id="Draft_Object" name="Черновик тура" />
    <bpmn:dataObjectReference id="Draft_Object_ref" name="Черновик тура" dataObjectRef="Draft_Object" />
    <bpmn:dataObject id="Scenes_Object" name="Сцены и переходы" />
    <bpmn:dataObjectReference id="Scenes_Object_ref" name="Сцены и переходы" dataObjectRef="Scenes_Object" />
    <bpmn:dataObject id="Validation_Object" name="Отчёт проверки" />
    <bpmn:dataObjectReference id="Validation_Object_ref" name="Отчёт проверки" dataObjectRef="Validation_Object" />
    <bpmn:dataObject id="Preview_Object" name="Предпросмотр" />
    <bpmn:dataObjectReference id="Preview_Object_ref" name="Предпросмотр" dataObjectRef="Preview_Object" />
    <bpmn:dataObject id="Published_Object" name="Версия тура и URL" />
    <bpmn:dataObjectReference id="Published_Object_ref" name="Версия тура и URL" dataObjectRef="Published_Object" />
    <bpmn:dataInputAssociation id="D1">
      <bpmn:sourceRef>Input_Package_ref</bpmn:sourceRef>
      <bpmn:targetRef>Check_Input</bpmn:targetRef>
    </bpmn:dataInputAssociation>
    <bpmn:dataOutputAssociation id="D2">
      <bpmn:targetRef>Draft_Object_ref</bpmn:targetRef>
      <bpmn:sourceRef>Create_Draft</bpmn:sourceRef>
    </bpmn:dataOutputAssociation>
    <bpmn:dataInputAssociation id="D3">
      <bpmn:sourceRef>Draft_Object_ref</bpmn:sourceRef>
      <bpmn:targetRef>Load_Scenes</bpmn:targetRef>
    </bpmn:dataInputAssociation>
    <bpmn:dataOutputAssociation id="D4">
      <bpmn:targetRef>Scenes_Object_ref</bpmn:targetRef>
      <bpmn:sourceRef>Load_Scenes</bpmn:sourceRef>
    </bpmn:dataOutputAssociation>
    <bpmn:dataInputAssociation id="D5">
      <bpmn:sourceRef>Scenes_Object_ref</bpmn:sourceRef>
      <bpmn:targetRef>Validate_Tour</bpmn:targetRef>
    </bpmn:dataInputAssociation>
    <bpmn:dataOutputAssociation id="D6">
      <bpmn:targetRef>Validation_Object_ref</bpmn:targetRef>
      <bpmn:sourceRef>Validate_Tour</bpmn:sourceRef>
    </bpmn:dataOutputAssociation>
    <bpmn:dataInputAssociation id="D7">
      <bpmn:sourceRef>Validation_Object_ref</bpmn:sourceRef>
      <bpmn:targetRef>Build_Preview</bpmn:targetRef>
    </bpmn:dataInputAssociation>
    <bpmn:dataOutputAssociation id="D8">
      <bpmn:targetRef>Preview_Object_ref</bpmn:targetRef>
      <bpmn:sourceRef>Build_Preview</bpmn:sourceRef>
    </bpmn:dataOutputAssociation>
    <bpmn:dataInputAssociation id="D9">
      <bpmn:sourceRef>Preview_Object_ref</bpmn:sourceRef>
      <bpmn:targetRef>Publish</bpmn:targetRef>
    </bpmn:dataInputAssociation>
    <bpmn:dataOutputAssociation id="D10">
      <bpmn:targetRef>Published_Object_ref</bpmn:targetRef>
      <bpmn:sourceRef>Publish</bpmn:sourceRef>
    </bpmn:dataOutputAssociation>
  </bpmn:process>
  <bpmn:message id="Message_Input" name="Проверенный комплект панорам" />
  <bpmn:message id="Message_Return" name="Запрос на доработку" />
  <bpmn:message id="Message_URL" name="URL опубликованного тура" />
  <bpmn:collaboration id="Collaboration_Tour">
    <bpmn:participant id="Participant_Realtor" name="Риелтор" />
    <bpmn:participant id="Participant_Tour" name="Сборка и публикация тура" processRef="Process_Tour" />
    <bpmn:messageFlow id="M1" sourceRef="Participant_Realtor" targetRef="Start_Input" messageRef="Message_Input" />
    <bpmn:messageFlow id="M2" sourceRef="Return_Input" targetRef="Participant_Realtor" messageRef="Message_Return" />
    <bpmn:messageFlow id="M3" sourceRef="Transfer_URL" targetRef="Participant_Realtor" messageRef="Message_URL" />
  </bpmn:collaboration>
